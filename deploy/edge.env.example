# Copy to /etc/tablewatch/edge.env (install.sh does this) and fill in.
# Camera RTSP address. Find it in the camera's app or manual. Contains the camera
# password, so this file is readable by root and the tablewatch user only.
CAMERA_URL=rtsp://USER:PASSWORD@192.168.1.50:554/stream1
# Optional extra agent flags, e.g. "--every 3 --confirm 3 --conf 0.35"
EDGE_ARGS=
